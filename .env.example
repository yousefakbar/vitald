# Google Cloud OAuth web client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://127.0.0.1:8765/callback

# vitald
VITALD_TIMEZONE=Asia/Riyadh
VITALD_LOG_FORMAT=text
VITALD_HTTP_TIMEOUT=60s
# Optional local defaults:
# VITALD_TOKEN_PATH=$HOME/.config/vitald/token.json
# VITALD_RAW_DATA_PATH=data/raw

# PostgreSQL
POSTGRES_DB=vitald
POSTGRES_USER=vitald
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://vitald:change-me@127.0.0.1:5432/vitald?sslmode=disable

# Encrypted Restic backups. Local and mounted NAS paths are supported directly;
# Restic repository URLs such as sftp: and s3: are also accepted.
VITALD_BACKUP_REPOSITORY=./backups
RESTIC_PASSWORD_FILE=.restic-password
VITALD_BACKUP_KEEP_DAILY=7
VITALD_BACKUP_KEEP_WEEKLY=4
VITALD_BACKUP_KEEP_MONTHLY=12
# Stable Restic host grouping; make this unique if a repository is shared.
VITALD_BACKUP_HOST=vitald
# Optional for SFTP repositories; mounted read-only at /root/.ssh.
# VITALD_BACKUP_SSH_DIR=$HOME/.ssh
