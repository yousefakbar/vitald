      "pluginVersion": "13.1.0",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vitald-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    metric AS \"Metric\",\n    CASE\n        WHEN latest_successful_sync_at IS NULL THEN 'critical'\n        WHEN successful_sync_age >= interval '24 hours' THEN 'critical'\n        WHEN successful_sync_age >= interval '12 hours' THEN 'warning'\n        ELSE 'healthy'\n    END AS \"Freshness\",\n    round(\n        (extract(epoch FROM successful_sync_age) / 3600.0)::numeric,\n        1\n    )::double precision AS \"Successful sync age (hours)\",\n    latest_metric_status AS \"Latest metric status\",\n    latest_successful_sync_at AS \"Latest successful sync\",\n    checkpoint_at AS \"Checkpoint\",\n    latest_local_date AS \"Latest data date\",\n    latest_imported_at AS \"Latest import\",\n    latest_archived_at AS \"Latest archive\",\n    record_count AS \"Records\",\n    latest_metric_error AS \"Latest error\"\nFROM analytics.pipeline_freshness\nORDER BY metric;",
          "refId": "A"
        }
      ],
      "title": "Per-metric Pipeline Health",
      "type": "table"
    },
