        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vitald-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH series AS (\n    SELECT\n        local_date,\n        exercise_minutes,\n        avg(exercise_minutes) OVER (\n            ORDER BY local_date\n            ROWS BETWEEN 6 PRECEDING AND CURRENT ROW\n        ) AS rolling_average_minutes\n    FROM analytics.daily_summary\n),\ndaily AS (\n    SELECT\n        local_date::timestamp AT TIME ZONE 'Asia/Riyadh' AS \"time\",\n        exercise_minutes,\n        rolling_average_minutes\n    FROM series\n)\nSELECT\n    \"time\",\n    exercise_minutes AS \"Exercise\",\n    rolling_average_minutes AS \"7-day average\"\nFROM daily\nWHERE $__timeFilter(\"time\")\nORDER BY \"time\";",
          "refId": "A"
        }
      ],
      "title": "Daily Exercise Duration",
      "type": "timeseries"
    },
