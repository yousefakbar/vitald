          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    coalesce(\n        nullif(display_name, ''),\n        nullif(exercise_type, ''),\n        'Unknown'\n    ) AS \"Exercise\",\n    count(*) AS \"Sessions\",\n    sum(duration_minutes) AS \"Minutes\",\n    sum(calories_kcal) AS \"Calories\",\n    sum(active_zone_minutes) AS \"Active-zone minutes\"\nFROM analytics.exercise_sessions\nWHERE $__timeFilter(started_at)\nGROUP BY 1\nORDER BY sum(duration_minutes) DESC;",
          "refId": "A"
        }
      ],
