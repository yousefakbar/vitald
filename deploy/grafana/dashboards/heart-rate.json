        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vitald-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH daily AS (\n    SELECT\n        local_date::timestamp AT TIME ZONE 'Asia/Riyadh' AS \"time\",\n        minimum_bpm,\n        average_bpm,\n        maximum_bpm\n    FROM analytics.heart_rate_daily\n)\nSELECT\n    \"time\",\n    minimum_bpm AS \"Minimum\",\n    average_bpm AS \"Average\",\n    maximum_bpm AS \"Maximum\"\nFROM daily\nWHERE $__timeFilter(\"time\")\nORDER BY \"time\";",
          "refId": "A"
        }
      ],
      "title": "Daily Heart-rate Range",
      "type": "timeseries"
    },
