          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH daily AS (\n    SELECT\n        local_date::timestamp AT TIME ZONE 'Asia/Riyadh' AS \"time\",\n        steps\n    FROM analytics.daily_summary\n)\nSELECT\n    \"time\",\n    steps AS \"Steps\"\nFROM daily\nWHERE $__timeFilter(\"time\")\nORDER BY \"time\";",
          "refId": "A"
        }
      ],
      "title": "Daily Steps",
      "type": "timeseries"
