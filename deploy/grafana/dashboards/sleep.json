          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    sleep_date AS \"Sleep date\",\n    started_at AS \"Started\",\n    ended_at AS \"Ended\",\n    duration_minutes / 60.0 AS \"Hours\",\n    sleep_type AS \"Type\"\nFROM analytics.sleep_sessions\nWHERE $__timeFilter(sleep_date::timestamp AT TIME ZONE 'Asia/Riyadh')\nORDER BY ended_at DESC;",
