      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vitald-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH daily AS (\n    SELECT\n        local_date::timestamp AT TIME ZONE 'Asia/Riyadh' AS \"time\",\n        CASE\n            WHEN sleep_minutes IS NULL THEN NULL\n            ELSE sleep_session_count\n        END AS session_count\n    FROM analytics.daily_summary\n)\nSELECT\n    \"time\",\n    session_count AS \"Sessions\"\nFROM daily\nWHERE $__timeFilter(\"time\")\nORDER BY \"time\";",
          "refId": "A"
        }
      ],
      "title": "Sleep-session Count",
      "type": "timeseries"
