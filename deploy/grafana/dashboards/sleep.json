      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vitald-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH series AS (\n    SELECT\n        local_date,\n        sleep_minutes / 60.0 AS sleep_hours,\n        avg(sleep_minutes / 60.0) OVER (\n            ORDER BY local_date\n            ROWS BETWEEN 6 PRECEDING AND CURRENT ROW\n        ) AS rolling_average_hours\n    FROM analytics.daily_summary\n),\ndaily AS (\n    SELECT\n        local_date::timestamp AT TIME ZONE 'Asia/Riyadh' AS \"time\",\n        sleep_hours,\n        rolling_average_hours\n    FROM series\n)\nSELECT\n    \"time\",\n    sleep_hours AS \"Sleep\",\n    rolling_average_hours AS \"7-day average\"\nFROM daily\nWHERE $__timeFilter(\"time\")\nORDER BY \"time\";",
          "refId": "A"
        }
      ],
      "title": "Daily Sleep and Rolling Average",
      "type": "timeseries"
    },
