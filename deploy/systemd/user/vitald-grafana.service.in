[Unit]
Description=vitald Grafana container
Documentation=file://@VITALD_ROOT@/docs/SCHEDULING.md
Requires=vitald-postgres.service
After=vitald-postgres.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@VITALD_ROOT@
Environment="VITALD_ENV_FILE=@VITALD_ENV_FILE@"
Environment="VITALD_CONTAINER_ENGINE=@VITALD_CONTAINER_ENGINE@"
ExecStart=@VITALD_ROOT@/scripts/systemd-run.sh grafana-start
ExecStop=@VITALD_ROOT@/scripts/systemd-run.sh grafana-stop
TimeoutStartSec=2min
TimeoutStopSec=2min

[Install]
WantedBy=default.target
